{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["chrome", "vite/client", "node"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "dev-hooks": ["src/dev/hooks.stub.ts"] }
  },
  "include": ["src", "test", "build.mjs"]
}
