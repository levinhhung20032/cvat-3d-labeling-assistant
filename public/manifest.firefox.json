{
  "manifest_version": 3,
  "name": "CVAT 3D Labeling Assistant",
  "version": "0.0.1",
  "description": "Hỗ trợ review và sửa nhãn cuboid 3D trong tab job CVAT.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://cvat-a.example.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Bật/tắt CVAT 3D Assistant"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "assets/*"
      ],
      "matches": [
        "https://cvat-a.example.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cvat-3d-assistant@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
