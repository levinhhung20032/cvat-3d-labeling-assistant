{
  "name": "cvat-3d-labeling-assistant",
  "version": "1.6.7",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --target=dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:firefox": "node build.mjs --target=firefox",
    "build:all": "node build.mjs && node build.mjs --target=firefox",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "start:firefox": "web-ext run --source-dir dist-firefox --start-url https://cvat-a.example.com/",
    "package:firefox": "web-ext build --source-dir dist-firefox --artifacts-dir web-ext-artifacts --overwrite-dest"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^5.5.4",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  }
}
